[
 {
  "start": 0.28,
  "end": 1.58,
  "text": "Zameen khareedne se pehle sirf"
 },
 {
  "start": 1.58,
  "end": 3.49,
  "text": "location aur rate mat dekhiye."
 },
 {
  "start": 3.5,
  "end": 5.34,
  "text": "Yeh 10 checks zaroor kijiye."
 },
 {
  "start": 5.34,
  "end": 7.2,
  "text": "Pehla— maalik kaun hai?"
 },
 {
  "start": 7.41,
  "end": 8.59,
  "text": "Seller ki identity,"
 },
 {
  "start": 8.59,
  "end": 10.46,
  "text": "purani registries aur ownership ki"
 },
 {
  "start": 10.46,
  "end": 12.59,
  "text": "poori chain lawyer se verify karaiye."
 },
 {
  "start": 12.59,
  "end": 14.95,
  "text": "Doosra— zameen ke records."
 },
 {
  "start": 14.95,
  "end": 16.84,
  "text": "Jamabandi, yaani revenue record,"
 },
 {
  "start": 16.84,
  "end": 18.07,
  "text": "aur naamantaran,"
 },
 {
  "start": 18.07,
  "end": 19.83,
  "text": "yaani records mein naam badalne ki"
 },
 {
  "start": 19.83,
  "end": 21.09,
  "text": "entry, check kijiye."
 },
 {
  "start": 21.09,
  "end": 23.67,
  "text": "Sirf online screenshot par deal mat kijiye."
 },
 {
  "start": 23.84,
  "end": 25.65,
  "text": "Teesra— bechne ka haq."
 },
 {
  "start": 25.65,
  "end": 27.78,
  "text": "Joint owners, legal heirs aur"
 },
 {
  "start": 27.78,
  "end": 29.49,
  "text": "agricultural land ki transfer"
 },
 {
  "start": 29.49,
  "end": 31.17,
  "text": "restrictions check karaiye."
 },
 {
  "start": 31.17,
  "end": 33.31,
  "text": "Kya seller akela poori zameen bech sakta hai?"
 },
 {
  "start": 33.31,
  "end": 35.17,
  "text": "Chautha— loan aur dispute."
 },
 {
  "start": 35.17,
  "end": 36.58,
  "text": "Zameen girvi toh nahi?"
 },
 {
  "start": 36.58,
  "end": 38.25,
  "text": "Court case, stay order ya pehle se"
 },
 {
  "start": 38.25,
  "end": 39.82,
  "text": "sale agreement toh nahi?"
 },
 {
  "start": 39.82,
  "end": 41.62,
  "text": "Paanchva— land use."
 },
 {
  "start": 41.62,
  "end": 43.28,
  "text": "Aap ghar, warehouse ya resort"
 },
 {
  "start": 43.28,
  "end": 45.01,
  "text": "banana chahte hain— kya us use ki"
 },
 {
  "start": 45.01,
  "end": 45.9,
  "text": "permission hai?"
 },
 {
  "start": 45.9,
  "end": 47.48,
  "text": "Zaroori conversion aur approvals"
 },
 {
  "start": 47.48,
  "end": 48.81,
  "text": "verify kijiye."
 },
 {
  "start": 49.05,
  "end": 51.12,
  "text": "Chhatha— approval ki sachchai."
 },
 {
  "start": 51.12,
  "end": 53.61,
  "text": "‘JDA approved’ sunna kaafi nahi."
 },
 {
  "start": 53.72,
  "end": 55.26,
  "text": "Jaipur Development Authority ya"
 },
 {
  "start": 55.26,
  "end": 57.21,
  "text": "sambandhit authority se patta aur"
 },
 {
  "start": 57.21,
  "end": 59.22,
  "text": "approved layout verify kijiye."
 },
 {
  "start": 59.22,
  "end": 61.23,
  "text": "Saatva— actual measurement."
 },
 {
  "start": 61.23,
  "end": 62.85,
  "text": "Survey aur official demarcation se"
 },
 {
  "start": 62.85,
  "end": 65.11,
  "text": "boundary, area aur khasra number—"
 },
 {
  "start": 65.11,
  "end": 67.88,
  "text": "yaani land parcel ki pehchaan— match karaiye."
 },
 {
  "start": 67.88,
  "end": 68.86,
  "text": "Kabza kiske paas hai,"
 },
 {
  "start": 68.86,
  "end": 70.12,
  "text": "yeh bhi dekhiye."
 },
 {
  "start": 70.12,
  "end": 71.93,
  "text": "Aathva— legal raasta."
 },
 {
  "start": 71.93,
  "end": 73.64,
  "text": "Site tak gaadi pahunch rahi hai,"
 },
 {
  "start": 73.64,
  "end": 75.01,
  "text": "lekin kya us raaste se aane-jaane"
 },
 {
  "start": 75.01,
  "end": 76.43,
  "text": "ka legal haq bhi hai?"
 },
 {
  "start": 76.43,
  "end": 78.56,
  "text": "Width aur records check kijiye."
 },
 {
  "start": 78.56,
  "end": 80.98,
  "text": "Nauva— zameen par restrictions."
 },
 {
  "start": 80.98,
  "end": 84.14,
  "text": "Proposed road, acquisition, naala,"
 },
 {
  "start": 84.14,
  "end": 86.15,
  "text": "flood risk, forest restriction ya"
 },
 {
  "start": 86.15,
  "end": 88.0,
  "text": "high-tension line toh nahi?"
 },
 {
  "start": 88.0,
  "end": 90.7,
  "text": "Dasva— total cost aur agreement."
 },
 {
  "start": 90.7,
  "end": 93.81,
  "text": "Registry, tax, brokerage, development,"
 },
 {
  "start": 93.81,
  "end": 96.35,
  "text": "bijli-paani aur pending dues jodiye."
 },
 {
  "start": 96.64,
  "end": 98.38,
  "text": "Token se pehle verification,"
 },
 {
  "start": 98.38,
  "end": 99.81,
  "text": "refund aur possession ki shartein"
 },
 {
  "start": 99.81,
  "end": 101.3,
  "text": "likhit mein rakhiye."
 },
 {
  "start": 101.37,
  "end": 103.13,
  "text": "Yaad rakhiye— zameen ka achha"
 },
 {
  "start": 103.13,
  "end": 104.19,
  "text": "sauda wahi hai,"
 },
 {
  "start": 104.19,
  "end": 105.57,
  "text": "jise aap legally own,"
 },
 {
  "start": 105.57,
  "end": 107.12,
  "text": "use aur aage sell kar sakein."
 }
]